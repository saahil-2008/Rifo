# Rifo backend — copy this file to .env and fill in the real keys.
# All values are read from environment variables; pydantic-settings maps the
# uppercase env names onto the config fields in app/config.py.

# ── Database (matches docker-compose.yml defaults) ──
DATABASE_URL=postgresql://rifo:rifo_dev_password@localhost:5432/rifo

# ── Vision extraction (Gemini 2.0 Flash). Required for real screenshots. ──
GEMINI_API_KEY=

# ── Google Fact Check Tools (short-circuit lookup) ──
GOOGLE_FACTCHECK_API_KEY=

# ── SerpApi Google Lens (reverse image search; metered) ──
SERPAPI_KEY=

# ── Optional LLM for explanation + localization (leave blank for
#    template/static-label fallbacks) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
