{
  "manifest_version": 3,
  "name": "Rifo — Claim Verifier",
  "short_name": "Rifo",
  "description": "Right-click any text or image to instantly fact-check it against the Rifo verification pipeline.",
  "version": "1.0.0",

  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Rifo Claim Verifier"
  }
}
